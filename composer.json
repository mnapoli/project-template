{
    "name": "mnapoli/myproject",
    "description": "Give it a nice description!",
    "keywords": [],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Matthieu Napoli",
            "email": "matthieu@mnapoli.fr"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/mnapoli"
        }
    ],
    "autoload": {
        "psr-4": {
            "MyProject\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyProject\\Test\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11|^12",
        "laravel/pint": "^1.24",
        "phpstan/phpstan": "^2",
        "rector/rector": "^2.0"
    },
    "scripts": {
        "lint": [
            "pint --parallel",
            "rector"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:types": "phpstan",
        "test:unit": "phpunit",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
